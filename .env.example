# Copiez ce fichier en `.env` et remplacez toutes les valeurs par vos propres secrets.

FLASK_APP=app.py
FLASK_ENV=development

SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Exemple PostgreSQL: postgresql+psycopg://user:password@host:5432/dbname
# Laisser vide pour utiliser SQLite local.
DATABASE_URL=

# Optionnel en production derrière HTTPS
# SESSION_COOKIE_SECURE=True
